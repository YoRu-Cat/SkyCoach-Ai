# Production frontend environment, consumed by Vite during `npm run build`.
#
# An empty VITE_API_URL means the application uses relative URLs such as
# `/api/predict`. The hosting platform's redirect rule (see netlify.toml)
# proxies those requests to the backend, so the SPA never needs to know
# the backend hostname directly.
VITE_API_URL=
VITE_USE_DEMO_WEATHER=false
