# Production frontend environment (used by Vite during `npm run build`).
# An empty VITE_API_URL means the app uses relative URLs like `/api/predict`.
# Netlify's [[redirects]] rule in netlify.toml then proxies them to Render,
# so the SPA never has to know the backend URL or deal with CORS.
VITE_API_URL=
VITE_USE_DEMO_WEATHER=false
