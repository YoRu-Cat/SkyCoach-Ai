# SkyCoach AI - .gitignore

# The .gitignore file itself (no untracked changes show in git status)
.gitignore

# ----- Secrets and credentials -----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.json
credentials.json

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ----- Node / frontend -----
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Build / compile artifacts -----
build/
dist/
*.so
*.dylib
*.dll

# ----- Logs / temp -----
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# ----- OS / editor -----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# ----- Claude Code session artifacts -----
.claude/
claude/

# ----- ML local artifacts (do not commit) -----
ml_system/data/datasets/*.cache.jsonl
ml_system/models/current/*.cache
ml_system/**/*.tmp.jsonl

# ----- Local-only configuration -----
.env.local
.netrc
*.pid

# ----- Misc archives -----
*.zip
*.tar.gz
*.tar
*.7z
*.rar
